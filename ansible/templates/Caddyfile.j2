{
{% if caddy_acme_email | default('') | length > 0 %}
    email {{ caddy_acme_email }}
{% endif %}
{% if caddy_auto_https | default('') | length > 0 %}
    auto_https {{ caddy_auto_https }}
{% endif %}
}

{{ caddy_site_addresses | default([media_domain]) | join(', ') }} {
{% if caddy_tls_internal | default(false) | bool %}    tls internal

{% endif %}
    encode zstd gzip

    @iiif path /iiif/*
    handle @iiif {
        reverse_proxy imageserver:8182
    }

    handle_path /asset/* {
        route {
            @asset_preflight method OPTIONS
            handle @asset_preflight {
                rewrite * /auth/asset{http.request.uri}
                reverse_proxy mediaserver:8000
            }

            @asset_methods not method GET HEAD OPTIONS
            respond @asset_methods "method not allowed" 405

            request_header -X-Oldap-Internal-Path
            request_header -X-Oldap-Content-Type
            request_header -X-Oldap-Content-Disposition
            request_header -X-Oldap-Cors-Allow-Origin
            header -X-Oldap-Internal-Path
            header -X-Oldap-Content-Type
            header -X-Oldap-Content-Disposition
            header -X-Oldap-Cors-Allow-Origin

            forward_auth mediaserver:8000 {
                uri /auth/asset{http.request.uri}
                copy_headers X-Oldap-Internal-Path X-Oldap-Content-Type X-Oldap-Content-Disposition X-Oldap-Cors-Allow-Origin
            }

            @no_internal not header X-Oldap-Internal-Path *
            respond @no_internal "forbidden" 403

            header {
                Content-Type "{http.request.header.X-Oldap-Content-Type}"
                Content-Disposition "{http.request.header.X-Oldap-Content-Disposition}"
                defer
            }

            @asset_cors header X-Oldap-Cors-Allow-Origin *
            header @asset_cors {
                Access-Control-Allow-Origin "{http.request.header.X-Oldap-Cors-Allow-Origin}"
                Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
                Access-Control-Allow-Headers "Authorization, Content-Type"
                Access-Control-Expose-Headers "Content-Disposition"
                Vary "Origin"
                defer
            }

            rewrite * {http.request.header.X-Oldap-Internal-Path}
            root * /
            file_server
        }
    }

    @upload path /upload /upload/*
    handle @upload {
        reverse_proxy mediaserver:8000
    }

    @import_sip path_regexp import_sip ^/imports/[0-9a-fA-F-]{36}/sip$
    handle @import_sip {
        @import_method not method PUT OPTIONS
        respond @import_method "method not allowed" 405
        request_body {
            max_size 500MB
        }
        reverse_proxy mediaserver:8000 {
            transport http {
                read_timeout 15m
                write_timeout 15m
            }
        }
    }

    # Purpose-specific API retrieval of retained validation reports. Mediahelper
    # validates a short-lived import-records JWT scoped to the exact import ID;
    # no other /internal route is exposed through Caddy.
    @import_report path_regexp import_report ^/internal/imports/[0-9a-fA-F-]{36}/records/report$
    handle @import_report {
        @import_report_method not method GET
        respond @import_report_method "method not allowed" 405
        reverse_proxy mediaserver:8000
    }

    # Exact API-to-media export source resolution boundary. Flask validates the
    # dedicated short-lived service JWT; broader /internal routing stays closed.
    @export_source_resolver path /internal/export-sources/resolve
    handle @export_source_resolver {
        @export_source_method not method POST
        respond @export_source_method "method not allowed" 405
        request_body {
            max_size 10MB
        }
        reverse_proxy mediaserver:8000
    }

    # Capability-protected immutable ZIP export delivery. Mediahelper validates
    # the exact exportId token and returns only a private fixed archive path.
    @export_archive path_regexp export_archive ^/exports/(?P<export_id>[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12})/archive$
    handle @export_archive {
        route {
            @export_method not method GET HEAD
            respond @export_method "method not allowed" 405

            request_header -X-Oldap-Internal-Path
            request_header -X-Oldap-Content-Type
            request_header -X-Oldap-Content-Disposition
            request_header -X-Oldap-Digest
            request_header -X-Oldap-Cors-Allow-Origin
            header -X-Oldap-Internal-Path
            header -X-Oldap-Content-Type
            header -X-Oldap-Content-Disposition
            header -X-Oldap-Digest
            header -X-Oldap-Cors-Allow-Origin

            forward_auth mediaserver:8000 {
                uri /auth/exports/{re.export_archive.export_id}/archive
                copy_headers X-Oldap-Internal-Path X-Oldap-Content-Type X-Oldap-Content-Disposition X-Oldap-Digest X-Oldap-Cors-Allow-Origin
            }

            @no_export_path not header X-Oldap-Internal-Path *
            respond @no_export_path "forbidden" 403
            header {
                Content-Type "{http.request.header.X-Oldap-Content-Type}"
                Content-Disposition "{http.request.header.X-Oldap-Content-Disposition}"
                Digest "{http.request.header.X-Oldap-Digest}"
                Accept-Ranges "bytes"
                defer
            }
            @export_cors header X-Oldap-Cors-Allow-Origin *
            header @export_cors {
                Access-Control-Allow-Origin "{http.request.header.X-Oldap-Cors-Allow-Origin}"
                Access-Control-Allow-Methods "GET, HEAD"
                Access-Control-Expose-Headers "Content-Disposition, Digest, Accept-Ranges"
                Vary "Origin"
                defer
            }
            rewrite * {http.request.header.X-Oldap-Internal-Path}
            root * /
            file_server
        }
    }

    @status path /health /status
    handle @status {
        reverse_proxy mediaserver:8000
    }

    @auth_any path /auth/*
    handle @auth_any {
        respond "not found" 404
    }

    handle {
        respond "not found" 404
    }
}
