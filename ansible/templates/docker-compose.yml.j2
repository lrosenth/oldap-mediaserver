services:
  mediaserver:
    image: lrosenth/oldap-mediahelper:{{ oldap_mediahelper_tag }}
    container_name: oldap-mediahelper
    env_file:
      - ./mediaserver.env
      - ./mediahelper-access.env
    environment:
      IIIF_BASE_URL: https://{{ media_domain }}/iiif/3/
      MEDIA_BASE_URL: https://{{ media_domain }}/
      APP_ENV: {{ app_env }}
      OLDAP_IMPORT_CALLBACK_RECONCILE_SECONDS: "{{ import_callback_reconcile_seconds }}"
      OLDAP_INGEST_PART_MAX_AGE_SECONDS: "{{ ingest_part_max_age_seconds }}"
      OLDAP_MOBILE_UPLOAD_ROOT: /data/mobile-uploads
    volumes:
      - {{ media_root }}:/data/images
      - {{ media_ingest_root }}:/data/ingest
      - {{ media_import_records_root }}:/data/import-records:ro
      - {{ media_export_root }}:/data/exports:ro
      - {{ media_mobile_upload_root }}:/data/mobile-uploads
    expose:
      - "8000"
    extra_hosts:
      - "host.docker.internal:host-gateway"
{% for extra_host in container_extra_hosts | default([]) %}
      - "{{ extra_host }}"
{% endfor %}
    restart: unless-stopped
    command:
      ["gunicorn",
       "-b", "0.0.0.0:8000",
       "--workers", "${GUNICORN_WORKERS:-1}",
       "--worker-class", "gthread",
       "--threads", "${GUNICORN_THREADS:-4}",
       "--timeout", "${GUNICORN_TIMEOUT:-900}",
       "--graceful-timeout", "${GUNICORN_GRACEFUL_TIMEOUT:-60}",
       "--keep-alive", "${GUNICORN_KEEPALIVE:-5}",
       "--access-logfile", "-",
       "--error-logfile", "-",
       "--log-level", "${GUNICORN_LOG_LEVEL:-info}",
       "app:app"]

  mobile-media-worker:
    profiles: ["mobile-media"]
    image: lrosenth/oldap-mediahelper:{{ oldap_mediahelper_tag }}
    container_name: oldap-mobile-media-worker
    env_file:
      - ./mobile-media-worker.env
    volumes:
      - {{ media_root }}:/data/images
      - {{ media_mobile_upload_root }}:/data/mobile-uploads
    read_only: true
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    tmpfs:
      - /tmp:rw,noexec,nosuid,nodev,size=256m
    cpus: 4.0
    mem_limit: 6g
    memswap_limit: 6g
    pids_limit: 128
    extra_hosts:
      - "host.docker.internal:host-gateway"
{% for extra_host in container_extra_hosts | default([]) %}
      - "{{ extra_host }}"
{% endfor %}
    restart: unless-stopped
    command: ["python", "-m", "mobile_upload_worker"]

  # Explicit operator opt-in until the ZIP-import pilot gate is approved.
  ingest-worker:
    profiles: ["zip-import-validation"]
    image: lrosenth/oldap-mediahelper:{{ oldap_mediahelper_tag }}
    container_name: oldap-ingest-worker
    env_file:
      - ./ingest-worker.env
    volumes:
      - {{ media_ingest_root }}:/data/ingest
      - {{ media_import_records_root }}:/data/import-records
      - {{ media_root }}:/data/images
    read_only: true
    cap_drop:
      - ALL
    cap_add:
      - CHOWN
      - DAC_OVERRIDE
      - FOWNER
      - KILL
      - SETGID
      - SETUID
    security_opt:
      - no-new-privileges:true
    tmpfs:
      - /tmp:rw,noexec,nosuid,nodev,size=256m
    cpus: 4.0
    mem_limit: 6g
    memswap_limit: 6g
    pids_limit: 128
    extra_hosts:
      - "host.docker.internal:host-gateway"
{% for extra_host in container_extra_hosts | default([]) %}
      - "{{ extra_host }}"
{% endfor %}
    restart: unless-stopped
    command: ["python", "-m", "ingest_worker"]

  export-worker:
    profiles: ["zip-export-worker"]
    image: lrosenth/oldap-mediahelper:{{ oldap_mediahelper_tag }}
    container_name: oldap-export-worker
    env_file:
      - ./export-worker.env
    volumes:
      - {{ media_root }}:/data/images:ro
      - {{ media_export_root }}:/data/exports
    read_only: true
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    tmpfs:
      - /tmp:rw,noexec,nosuid,nodev,size=64m
    cpus: 2.0
    mem_limit: 1g
    memswap_limit: 1g
    pids_limit: 64
    extra_hosts:
      - "host.docker.internal:host-gateway"
{% for extra_host in container_extra_hosts | default([]) %}
      - "{{ extra_host }}"
{% endfor %}
    restart: unless-stopped
    command: ["python", "-m", "export_worker"]

  imageserver:
{% if iiif_backend == 'sipi' %}
    image: {{ sipi_image | to_json }}
    entrypoint: ["/bin/sh", "/opt/sipi/examples/oldap/docker-entrypoint.sh"]
    environment:
      SIPI_LISTEN_ADDRESS: "0.0.0.0"
      SIPI_PORT: "8182"
      SIPI_IIIF_ROOT: /data/images
      SIPI_PREFLIGHT_SCRIPT: {{ ('/etc/sipi/preflight.lua' if sipi_preflight_source else '/opt/sipi/examples/oldap/preflight.lua') | to_json }}
      SIPI_PUBLIC_BASE_URL: {{ sipi_public_origin | to_json }}
      SIPI_CACHE_DIR: /var/cache/sipi
      SIPI_CACHE_MAX_BYTES: "{{ sipi_cache_max_bytes }}"
      SIPI_IIIF_WORKERS: "{{ sipi_workers }}"
      SIPI_JPEG_QUALITY: "{{ sipi_jpeg_quality }}"
      SIPI_JPEG_SAMPLING: {{ sipi_jpeg_sampling | to_json }}
      SIPI_CORS_ORIGINS: {{ sipi_cors_origins | to_json }}
      SIPI_CORS_CREDENTIALS: "{{ sipi_cors_credentials | bool | lower }}"
      OLDAP_SIPI_ANONYMOUS: "{{ sipi_anonymous_enabled | bool | lower }}"
      SIPI_PREFLIGHT_CONFIG_ANONYMOUS_PERMISSION_TTL: "{{ sipi_anonymous_permission_ttl }}"
    working_dir: /tmp
    read_only: true
    tmpfs:
      - /tmp:rw,noexec,nosuid,nodev,size=64m
    cap_drop: [ALL]
    security_opt: ["no-new-privileges:true"]
    pids_limit: 256
    mem_limit: {{ sipi_memory_limit }}
{% else %}
    image: lrosenth/oldap-imageserver:{{ oldap_imageserver_tag }}
{% endif %}
    container_name: oldap-imageserver
    env_file:
      - ./mediaserver.env
    volumes:
{% if iiif_backend == 'sipi' %}
      - {{ media_root }}:/data/images:ro
      - sipi_cache:/var/cache/sipi
{% if sipi_preflight_source %}
      - ./sipi-preflight.lua:/etc/sipi/preflight.lua:ro
{% endif %}
{% else %}
      - {{ media_root }}:/data/images
{% endif %}
    expose:
      - "8182"
    extra_hosts:
      - "host.docker.internal:host-gateway"
{% for extra_host in container_extra_hosts | default([]) %}
      - "{{ extra_host }}"
{% endfor %}
    restart: unless-stopped

  caddy:
    image: caddy:{{ caddy_image_tag }}
    container_name: oldap-media-caddy
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
      - {{ media_root }}:/data/images:ro
      - {{ media_export_root }}:/data/exports:ro
      - {{ caddy_data_dir }}:/data
      - {{ caddy_config_dir }}:/config
    depends_on:
      - mediaserver
      - imageserver
    restart: unless-stopped

volumes:
  sipi_cache:
