{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.oldap.org/schemas/zip-import/v1/report.schema.json",
  "title": "OLDAP ZIP import user validation report v1",
  "description": "Protected user-facing validation report. Stable issue codes and message keys are localized by the client; internal paths, tokens, and parser exception text are forbidden by this closed schema.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "documentType": {
      "const": "oldap.zip-import.report"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "importId": {
      "$ref": "https://api.oldap.org/schemas/zip-import/v1/common.schema.json#/$defs/ImportId"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": ["READY", "INVALID", "FAILED"]
    },
    "canConfirm": {
      "type": "boolean"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "target": {
      "$ref": "https://api.oldap.org/schemas/zip-import/v1/common.schema.json#/$defs/TargetSnapshot"
    },
    "sip": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "originalFileName": { "type": "string", "minLength": 1, "maxLength": 255 },
        "sizeBytes": { "type": "integer", "minimum": 0 },
        "sha256": {
          "$ref": "https://api.oldap.org/schemas/zip-import/v1/common.schema.json#/$defs/Sha256"
        }
      },
      "required": ["originalFileName", "sizeBytes", "sha256"]
    },
    "summary": {
      "$ref": "https://api.oldap.org/schemas/zip-import/v1/common.schema.json#/$defs/ValidationSummary"
    },
    "issues": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "https://api.oldap.org/schemas/zip-import/v1/common.schema.json#/$defs/Issue"
      }
    },
    "entries": {
      "type": "array",
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/ReportEntry" }
    },
    "manifestSha256": {
      "$ref": "https://api.oldap.org/schemas/zip-import/v1/common.schema.json#/$defs/Sha256"
    },
    "manifestCanonicalization": {
      "const": "RFC8785"
    }
  },
  "required": [
    "documentType",
    "schemaVersion",
    "importId",
    "generatedAt",
    "status",
    "canConfirm",
    "target",
    "sip",
    "summary",
    "issues",
    "entries"
  ],
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "READY" } },
        "required": ["status"]
      },
      "then": {
        "required": ["expiresAt"],
        "properties": {
          "canConfirm": { "const": true },
          "summary": {
            "properties": {
              "inventoryComplete": { "const": true },
              "errorCount": { "const": 0 },
              "rejectedEntries": { "const": 0 }
            }
          }
        }
      },
      "else": {
        "properties": { "canConfirm": { "const": false } },
        "not": { "required": ["expiresAt"] }
      }
    },
    {
      "if": {
        "properties": { "status": { "enum": ["READY", "INVALID"] } },
        "required": ["status"]
      },
      "then": {
        "required": ["manifestSha256", "manifestCanonicalization"]
      },
      "else": {
        "not": {
          "anyOf": [
            { "required": ["manifestSha256"] },
            { "required": ["manifestCanonicalization"] }
          ]
        }
      }
    }
  ],
  "$defs": {
    "ReportEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entryIndex": { "type": "integer", "minimum": 0, "maximum": 9999 },
        "sourcePath": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "normalizedPath": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "entryType": { "type": "string", "enum": ["file", "directory"] },
        "disposition": { "type": "string", "enum": ["IMPORT", "IGNORE", "REJECT"] },
        "sizeBytes": { "type": "integer", "minimum": 0 },
        "detectedCategory": {
          "type": "string",
          "enum": ["image", "audio", "video", "document", "unsupported"]
        },
        "detectedMimeType": { "type": "string", "minLength": 1, "maxLength": 127 },
        "issues": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "https://api.oldap.org/schemas/zip-import/v1/common.schema.json#/$defs/Issue"
          }
        }
      },
      "required": [
        "entryIndex",
        "sourcePath",
        "normalizedPath",
        "entryType",
        "disposition",
        "sizeBytes",
        "issues"
      ]
    }
  }
}
