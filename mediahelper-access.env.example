# Copy to mediahelper-access.env. Only the mediahelper upload service receives
# these operation-specific verification keys; the IIIF image server does not.
OLDAP_ACCESS_JWT_SECRET=
OLDAP_IMPORT_UPLOAD_JWT_SECRET=
OLDAP_IMPORT_SERVICE_JWT_SECRET=
OLDAP_IMPORT_RECORDS_JWT_SECRET=
OLDAP_EXPORT_SERVICE_JWT_SECRET=
OLDAP_EXPORT_DOWNLOAD_JWT_SECRET=
OLDAP_IMPORT_SERVICE_SUBJECT=media.oldap.org
OLDAP_INGEST_ROOT=/data/ingest
OLDAP_IMPORT_RECORDS_ROOT=/data/import-records
OLDAP_EXPORT_ROOT=/data/exports
